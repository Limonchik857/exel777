# Office Data Studio — локальная конфигурация.
# Скопируйте в .env и заполните значения.

# Обязательно: секретный ключ Django (production — генерируйте новый, не используйте dev-значение).
DJANGO_SECRET_KEY=office-data-studio-local-dev-secret

# False в production.
DJANGO_DEBUG=True

# ── Лимиты обработки данных ────────────────────────────────
DATA_MAX_FILE_SIZE=20          # МБ
DATA_MAX_ROWS=100000
DATA_MAX_COLUMNS=200
DATA_MAX_CELLS=5000000
MAX_MERGE_FILES=10
MAX_TOTAL_MERGE_SIZE=100       # МБ
PROCESSING_RETENTION_HOURS=24  # срок хранения обработок (cleanup)
SAFE_CSV_EXPORT=True           # защита от CSV-инъекций при экспорте

# ── Rate limiting (запросов в минуту) ──────────────────────
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_MERGE_PER_MINUTE=5
RATE_LIMIT_WORKFLOW_RUN_PER_MINUTE=20
RATE_LIMIT_EXPORT_PER_MINUTE=30